-- ============================================================================
-- Diagnostico: encontrar las tablas del modulo de Combos de Odoo
-- (product.combo / product.combo.item), que vinculan un producto tipo "Combo"
-- con su producto real (el que tiene la receta).
-- ============================================================================
 
SELECT table_name, column_name, data_type
FROM information_schema.columns
WHERE table_schema = 'public'
  AND (table_name ILIKE '%combo%')
ORDER BY table_name, ordinal_position;
 
